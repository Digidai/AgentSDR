{
  "name": "agentsdr-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "web:dev": "vite --host 127.0.0.1",
    "build": "node scripts/build-recorder.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply agentsdr-native --local",
    "db:remote": "wrangler d1 migrations apply agentsdr-native --remote",
    "check:runtime": "node scripts/runtime-smoke.mjs",
    "vendor:refresh": "node scripts/refresh-vendor.mjs"
  },
  "dependencies": {
    "@formulajs/formulajs": "^4.6.1",
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "fflate": "^0.8.3",
    "hono": "^4.10.0",
    "libphonenumber-js": "^1.13.15",
    "lodash": "^4.18.1",
    "lucide-react": "^0.468.0",
    "moment": "^2.31.0",
    "papaparse": "^5.5.3",
    "quickjs-emscripten-core": "^0.32.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/node": "^22",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9",
    "vite": "^7",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
